---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import { formatDate } from '../lib/date'

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const allTags = [...new Set(posts.flatMap((p) => p.data.tags.concat(p.data.series ?? [])))]
const fmt = (d: Date) => formatDate(d)
---

<BaseLayout title="ankurtrapasiya" description="Writing about infrastructure, LLMs, and automation.">
  <header class="site-header">
    <span class="name">ankurtrapasiya</span>
    <ThemeToggle />
  </header>

  <nav class="nav">
    <a href="https://github.com/ankurtrapasiya">github</a>
    <span class="sep">·</span>
    <a href="mailto:ankur.trapasiya@gmail.com">email</a>
  </nav>

  <p class="bio">
    I am a backend engineer who builds <strong>self-hosted LLM tooling</strong>.
    This is where I write about infrastructure, LLMs, and automation. <a class="more" href="https://github.com/ankurtrapasiya">More about me.</a>
  </p>

  <p class="chips filter-bar" id="filters">
    <a class="chip is-active" href="#filter" data-filter="all"><code>all</code></a>
    {
      allTags.map((tag) => (
        <a class="chip" href="#filter" data-filter={tag}><code>{tag}</code></a>
      ))
    }
  </p>

  <h2 class="sec">Some Recent Writing</h2>
  <ol class="posts">
    {
      posts.map((post) => (
        <li class="post" data-tags={post.data.tags.concat(post.data.series ?? []).join(' ')}>
          <p class="postline">
            <time class="date" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            <a class="ptitle" href={`/posts/${post.id}/`}>{post.data.title}</a>
            <span class="ptags">
              {post.data.tags.concat(post.data.series ?? []).map((t) => <span>{t}</span>)}
            </span>
          </p>
          <p class="summary">{post.data.summary}</p>
        </li>
      ))
    }
  </ol>

  <h2 class="sec">Some Favorite Things</h2>
  <div class="fav">
    <a href="https://github.com/ankurtrapasiya">GitHub</a>
    <a href="mailto:ankur.trapasiya@gmail.com">Email</a>
  </div>

  <footer class="foot">© 2026 Ankur Trapasiya</footer>
</BaseLayout>

<style>
  .site-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.1rem; }
  .name { font-family: Georgia, 'Iowan Old Style', Charter, serif; font-size: 1.02rem; font-weight: 700; letter-spacing: 0.02em; }

  .nav { margin: 0.4rem 0 0; font-size: 0.86rem; font-family: ui-sans-serif, system-ui, sans-serif; }
  .nav a { text-decoration: none; }
  .nav a:hover { text-decoration: underline; }
  .nav .sep { color: var(--muted); margin: 0 0.6rem; }

  .bio { margin: 2rem 0 2.2rem; line-height: 1.55; }
  .bio .more { font-size: 0.9em; }

  .sec { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
    font-family: ui-sans-serif, system-ui, sans-serif; font-weight: 600; margin: 0 0 0.6rem; }

  .filter-bar { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0 0 1.4rem; font-family: ui-sans-serif, system-ui, sans-serif; }
  .filter-bar a { text-decoration: none; color: var(--muted); }
  .chip code { background: none; border: 1px solid var(--border); border-radius: 999px; padding: 0.08em 0.6em; font-size: 0.74em; }
  .chip:hover code { border-color: var(--fg); color: var(--fg); }
  .chip.is-active code { color: var(--fg); border-color: var(--fg); }

  .posts { list-style: none; margin: 0; padding: 0; }
  .post { border-top: 1px solid var(--border); padding: 0.55rem 0 0.75rem; }
  .post[hidden] { display: none; }
  .postline { display: flex; align-items: baseline; gap: 1rem; margin: 0; }
  .date { color: var(--muted); font-size: 0.82em; font-family: ui-sans-serif, system-ui, sans-serif; white-space: nowrap; }
  .ptitle { font-family: Georgia, 'Iowan Old Style', Charter, serif; font-size: 1.08rem; font-weight: 600; text-decoration: none; }
  .ptitle:hover { text-decoration: underline; }
  .ptags { margin-left: auto; color: var(--muted); font-size: 0.72rem; font-family: ui-sans-serif, system-ui, sans-serif; }
  .ptags span { margin-left: 0.5rem; white-space: nowrap; }
  .summary { color: var(--muted); margin: 0.25rem 0 0 6.5rem; font-size: 0.92em; }

  .fav { display: flex; gap: 1.4rem; font-size: 0.92em; }
  .fav a { text-decoration: none; }
  .fav a:hover { text-decoration: underline; }

  .foot { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--border);
    color: var(--muted); font-size: 0.8em; font-family: ui-sans-serif, system-ui, sans-serif; }

  @media (max-width: 40rem) {
    .ptags { display: none; }
    .summary { margin-left: 0; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLParagraphElement>('#filters')
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('.post'))
  bar?.addEventListener('click', (event) => {
    const chip = (event.target as HTMLElement).closest('[data-filter]') as HTMLElement | null
    if (!chip) return
    bar.querySelectorAll('.chip').forEach((c) => c.classList.remove('is-active'))
    chip.classList.add('is-active')
    const filter = chip.dataset.filter!
    items.forEach((item) => {
      const matches = filter === 'all' || item.dataset.tags!.split(' ').includes(filter)
      item.hidden = !matches
    })
  })
</script>