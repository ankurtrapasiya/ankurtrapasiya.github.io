---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ThemeToggle from '../../components/ThemeToggle.astro'
import { formatDate } from '../../lib/date'

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const words = post.body.split(/\s+/).filter(Boolean).length
const minutes = Math.max(1, Math.round(words / 200))
const fmt = (d: Date) => formatDate(d, true)
---

<BaseLayout title={`${post.data.title} · ankurtrapasiya`} description={post.data.summary}>
  <header class="site-header ui">
    <a class="site-name" href="/">ankurtrapasiya</a>
    <ThemeToggle />
  </header>

  <article class="post">
    <p class="meta">
      <time datetime={fmt(post.data.date)}>{fmt(post.data.date)}</time>
      · {minutes} min read
      · {post.data.tags.join(', ')}
      {post.data.github && <a class="github" href={`https://github.com/${post.data.github}`}>View on GitHub ↗</a>}
    </p>
    <h1 class="title">{post.data.title}</h1>
    {post.data.series && <p class="series ui"><code>{post.data.series}</code></p>}
    <Content class="post-body" />
  </article>
</BaseLayout>

<style>
  .site-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.75rem; }
  .site-name { text-decoration: none; font-weight: 600; }
  .meta { color: var(--muted); font-size: 0.85em; margin-bottom: 0.5rem; }
  .github { margin-left: 0.75rem; white-space: nowrap; }
  .title { font-size: 1.7rem; line-height: 1.25; margin-bottom: 0.25rem; font-weight: 700; }
  .series code { border: 1px dashed var(--border); border-radius: 999px; padding: 0.1em 0.6em; font-size: 0.8em; color: var(--muted); }
  .post-body { color: var(--fg); }
</style>